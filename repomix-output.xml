</div>

<script>
  // ==================== CONFIGURACIÓN ====================
  const API_BASE = 'http://localhost:3000'; // ← Cambia si tu backend corre en otro puerto

  // ==================== UTILS ====================
  async function apiFetch(endpoint, options = {}) {
    const url = endpoint.startsWith('http') ? endpoint : `${API_BASE}${endpoint}`;
    try {
      const res = await fetch(url, options);
      let data;
      try { data = await res.json(); } catch { data = { error: 'No se pudo parsear respuesta' }; }
      return { status: res.status, ok: res.ok, data };
    } catch (err) {
      return { status: 0, ok: false, data: { error: err.message } };
    }
  }

  function displayResult(elementId, obj) {
    document.getElementById(elementId).textContent = JSON.stringify(obj, null, 2);
  }

  // ==================== FILES ====================
  async function loadFileList() {
    const container = document.getElementById('fileList');
    const result = await apiFetch('/files');
    if (!result.ok) {
      container.innerHTML = `<p>⚠️ Error al cargar: ${result.data?.error || 'desconocido'}</p>`;
      return;
    }
    const files = result.data;
    if (!files || files.length === 0) {
      container.innerHTML = '<p>No hay archivos subidos.</p>';
      return;
    }
    container.innerHTML = files.map(f => `
      <div class="file-item">
        <span><strong>${f.originalName}</strong> (${f.category || 'general'}) <span class="tag">${f.extension || ''}</span></span>
        <span>
          <span class="file-url" onclick="copyToClipboard('${f.url}')">${f.url}</span>
          <button class="btn btn-sm btn-danger" onclick="deleteFile('${f._id}')">🗑️</button>
          <input type="checkbox" class="file-select" value="${f.url}" data-id="${f._id}">
        </span>
      </div>
    `).join('');
  }

  window.copyToClipboard = (text) => {
    navigator.clipboard?.writeText(text).then(() => {
      alert('URL copiada al portapapeles');
    }).catch(() => {
      const inp = document.createElement('input');
      inp.value = text;
      document.body.appendChild(inp);
      inp.select();
      document.execCommand('copy');
      document.body.removeChild(inp);
      alert('URL copiada');
    });
  };

  window.deleteFile = async (id) => {
    if (!confirm('¿Eliminar este archivo?')) return;
    const result = await apiFetch(`/files/${id}`, { method: 'DELETE' });
    if (result.ok) {
      alert('Eliminado');
      loadFileList();
    } else {
      alert('Error: ' + (result.data?.message || 'desconocido'));
    }
  };

  // Subir archivo (con FormData)
  document.getElementById('uploadForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fileInput = document.getElementById('fileInput');
    if (!fileInput.files.length) {
      alert('Selecciona un archivo');
      return;
    }
    const formData = new FormData();
    formData.append('file', fileInput.files[0]);
    formData.append('category', document.getElementById('categoryInput').value || '');
    formData.append('uploadedBy', document.getElementById('uploadedByInput').value || '');

    const result = await apiFetch('/files/upload', {
      method: 'POST',
      body: formData,
    });
    displayResult('uploadResult', result);
    if (result.ok) {
      loadFileList();
      fileInput.value = '';
    }
  });

  document.getElementById('refreshFilesBtn').addEventListener('click', loadFileList);

  // ==================== DESIGN SPRINT ====================

  // Registrar evidencia
  document.getElementById('registerEvidenceForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const equipoId = parseInt(document.getElementById('regEquipoId').value);
    const proyectoId = document.getElementById('regProyectoId').value;
    const fase = document.getElementById('regFase').value;
    const archivosUrlsRaw = document.getElementById('regArchivosUrls').value;
    const comentarios = document.getElementById('regComentarios').value;

    if (!equipoId || !proyectoId) {
      displayResult('registerResult', { error: 'equipoId y proyectoId son requeridos' });
      return;
    }

    const body = { equipoId, proyectoId, fase, comentarios: comentarios || undefined };
    if (archivosUrlsRaw) {
      body.archivosUrls = archivosUrlsRaw.split(',').map(s => s.trim()).filter(Boolean);
    }

    const result = await apiFetch('/design-sprint/evidencias', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    displayResult('registerResult', result);
  });

  // Añadir URLs seleccionadas de la lista
  document.getElementById('addSelectedUrlsBtn').addEventListener('click', () => {
    const checkboxes = document.querySelectorAll('.file-select:checked');
    const urls = Array.from(checkboxes).map(cb => cb.value);
    if (!urls.length) {
      alert('Selecciona al menos un archivo de la lista.');
      return;
    }
    const input = document.getElementById('regArchivosUrls');
    const current = input.value ? input.value.split(',').map(s => s.trim()).filter(Boolean) : [];
    const merged = [...current, ...urls];
    input.value = merged.join(', ');
    checkboxes.forEach(cb => cb.checked = false);
  });

  // Consultar avance
  document.getElementById('getAvanceBtn').addEventListener('click', async () => {
    const equipoId = parseInt(document.getElementById('getEquipoId').value);
    const proyectoId = document.getElementById('getProyectoId').value;
    if (!equipoId || !proyectoId) {
      displayResult('avanceResult', { error: 'equipoId y proyectoId requeridos' });
      return;
    }
    const url = `/design-sprint/equipos/${equipoId}/proyectos/${proyectoId}`;
    const result = await apiFetch(url);
    displayResult('avanceResult', result);
  });

  // Consultar fase específica
  document.getElementById('getFaseBtn').addEventListener('click', async () => {
    const equipoId = parseInt(document.getElementById('faseEquipoId').value);
    const proyectoId = document.getElementById('faseProyectoId').value;
    const fase = document.getElementById('faseSelect').value;
    if (!equipoId || !proyectoId) {
      displayResult('faseResult', { error: 'equipoId y proyectoId requeridos' });
      return;
    }
    const url = `/design-sprint/equipos/${equipoId}/proyectos/${proyectoId}/fases/${fase}`;
    const result = await apiFetch(url);
    displayResult('faseResult', result);
  });

  // ==================== INICIALIZAR ====================
  loadFileList();
</script>

</body>
</html>
