<body>

<h1>🧪 Test Design Sprint + File Manager</h1>

<div class="grid">

  <!-- COLUMNA IZQUIERDA: Gestión de archivos -->
  <div>
    <section>
      <h2>📁 Subir archivo</h2>
      <form id="uploadForm">
        <div class="form-group">
