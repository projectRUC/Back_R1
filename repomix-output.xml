    .btn-danger:hover { background: #dc2626; }
    .btn-sm { padding: 0.3rem 0.8rem; font-size: 0.85rem; }
    .result { background: #f1f5f9; padding: 0.75rem; border-radius: 4px; margin-top: 0.75rem; white-space: pre-wrap; font-size: 0.9rem; max-height: 250px; overflow: auto; border: 1px solid #e2e8f0; }
    .file-list { margin: 0.5rem 0; }
    .file-item { display: flex; justify-content: space-between; align-items: center; padding: 0.3rem 0; border-bottom: 1px solid #e2e8f0; }
