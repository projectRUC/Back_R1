          <label>Subido por</label>
          <input type="text" id="uploadedByInput" placeholder="userId o nombre">
        </div>
        <button type="submit" class="btn">Subir</button>
      </form>
      <div id="uploadResult" class="result">Resultado de subida</div>
    </section>

    <section>
      <h2>📋 Lista de archivos</h2>
      <button class="btn btn-sm" id="refreshFilesBtn">↻ Refrescar</button>
      <div id="fileList" class="file-list">
        <p>Cargando...</p>
      </div>
    </section>
  </div>

  <!-- COLUMNA DERECHA: Design Sprint -->
  <div>
    <section>
      <h2>📝 Registrar evidencia</h2>
      <form id="registerEvidenceForm">
        <div class="form-group">
          <label>equipoId *</label>
          <input type="number" id="regEquipoId" required placeholder="1" value="1">
        </div>
        <div class="form-group">
          <label>proyectoId *</label>
          <input type="text" id="regProyectoId" required placeholder="MongoID" value="67e8d3c2b5a1f2d4e6c8f9a0">
        </div>
        <div class="form-group">
          <label>Fase *</label>
          <select id="regFase">
            <option value="mapear">mapear</option>
            <option value="bocetar">bocetar</option>
            <option value="decidir">decidir</option>
            <option value="prototipar">prototipar</option>
          </select>
        </div>
        <div class="form-group">
          <label>URLs de archivos</label>
          <input type="text" id="regArchivosUrls" placeholder="Separa con comas, o usa el botón 'Añadir desde lista'">
          <button type="button" class="btn btn-sm" id="addSelectedUrlsBtn">➕ Añadir seleccionados</button>
        </div>
        <div class="form-group">
          <label>Comentarios</label>
          <textarea id="regComentarios" placeholder="Opcional"></textarea>
        </div>
        <button type="submit" class="btn">Registrar</button>
