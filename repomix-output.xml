  /**
   * DELETE /dashboard/detalle-proyecto-equipo/:equipoId/miembros/:usuId
   * Elimina un integrante de la nómina del equipo (protegiendo al creador del proyecto).
   */
  @Delete('detalle-proyecto-equipo/:equipoId/miembros/:usuId')
